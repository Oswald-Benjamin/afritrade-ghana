# Environment Configuration
# Copy to .env.local and fill in values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AfriTrade Ghana
NODE_ENV=development

# MTN MoMo API
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_ENV=sandbox

# Telecel Cash API
TELECEL_API_KEY=
TELECEL_API_SECRET=
TELECEL_ENV=sandbox

# AirtelTigo Money API
AIRTELTIGO_API_KEY=
AIRTELTIGO_API_SECRET=
AIRTELTIGO_ENV=sandbox

# GSE Market Data
GSE_DATA_PROVIDER=
GSE_API_KEY=
GSE_FEED_URL=

# Ghana Card (NIA) Verification
NIA_API_KEY=
NIA_API_URL=

# Security
JWT_SECRET=
ENCRYPTION_KEY=

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
